msgstr "Слишком много попыток. Подождите немного и попробуйте снова."

#, python-format
msgid "Xabar yuborish uchun <a class=\"link\" href=\"%(login_url)s\">hisobingizga kiring</a>."
msgstr "Чтобы отправить сообщение, <a class=\"link\" href=\"%(login_url)s\">войдите в аккаунт</a>."

