#: .\user\views.py:410
msgid "Parol yangilandi. Endi kirishingiz mumkin."
msgstr "Пароль обновлён. Теперь вы можете войти."

#~ msgid "Yoʻlda"
#~ msgstr "В пути"

#~ msgid ""
#~ "Maʼlum bir grafika yoki dizayndagi futbolkani izlash qancha vaqt olishini "
#~ "bilamiz. Shuning uchun bu ishni siz uchun yengillashtirdik: saytdagi har "
#~ "bir dizayn Toshkentda, omborda turadi va bugunoq joʻnatilishi mumkin."
#~ msgstr ""
#~ "Мы знаем, сколько времени уходит на поиск футболки с нужным принтом. "
#~ "Поэтому упростили эту задачу: каждый дизайн на сайте лежит на складе в "
#~ "Ташкенте и может уехать к вам сегодня же."

#~ msgid ""
#~ "Har bir mahsulot sifat jihatidan tekshiriladi — sifatsiz print ham, arzon "
#~ "mato ham yoʻq. Doʻkonga qoʻyilgan har bir futbolka oʻzimiz ham kiyadigan "
#~ "darajada."
#~ msgstr ""
#~ "Каждая вещь проходит проверку качества — ни плохой печати, ни дешёвой "
#~ "ткани. Всё, что попадает в магазин, мы носим и сами."

#~ msgid "Savolingiz bormi yoki oʻz dizayningizni bosdirmoqchimisiz? Yozing."
#~ msgstr "Есть вопрос или хотите напечатать свой дизайн? Напишите нам."

#~ msgid ""
#~ "Butun Oʻzbekiston boʻylab, Oʻzbekiston pochtasi orqali — Toshkentda ham, "
#~ "viloyatlarda ham."
#~ msgstr ""
#~ "По всему Узбекистану, через «Узбекистон почтаси» — и в Ташкенте, и в "
#~ "областях."

#~ msgid "Pochta boʻlimiga"
#~ msgstr "До отделения почты"

#~ msgid ""
#~ "Rasmiylashtirishda viloyat va tumaningizni tanlab, oʻzingiz buyurtmani "
#~ "oladigan pochta boʻlimining 6 xonali indeksini yozasiz. Indeksni "
#~ "bilmasangiz, Oʻzbekiston pochtasining boʻlimlar xaritasidan topishingiz "
#~ "mumkin — havola rasmiylashtirish sahifasida."
#~ msgstr ""
#~ "При оформлении вы выбираете область и район и указываете шестизначный "
#~ "индекс того отделения, где будете забирать заказ. Не знаете индекс — "
#~ "найдите отделение на карте «Узбекистон почтаси»; ссылка есть на странице "
#~ "оформления."

#~ msgid "Eshikkacha"
#~ msgstr "До двери"

#~ msgid ""
#~ "Kuryer buyurtmani siz koʻrsatgan manzilga olib boradi. Manzilni qoʻlda "
#~ "yozishingiz yoki xaritada belgilab qoʻyishingiz mumkin — xaritadagi belgi "
#~ "manzilni aniqlashtiradi, lekin manzilning oʻzi baribir kerak."
#~ msgstr ""
#~ "Курьер привезёт заказ по указанному адресу. Адрес можно ввести вручную "
#~ "или отметить точкой на карте — точка уточняет адрес, но сам адрес нужен в "
#~ "любом случае."

#~ msgid "Qancha vaqt ketadi?"
#~ msgstr "Сколько идёт доставка?"

#~ msgid "Buyurtmani olib ketmasangiz nima boʻladi?"
#~ msgstr "Что будет, если не забрать заказ?"

#~ msgid ""
#~ "Joʻnatma pochta boʻlimida bir oy saqlanadi. Shu muddat ichida olib "
#~ "ketilmasa, u bizga qaytariladi. Shuning uchun boʻlim indeksini diqqat "
#~ "bilan tekshiring — buyurtma tasdiqlangandan keyin uni tasdiq sahifasida "
#~ "qayta koʻrishingiz mumkin."
#~ msgstr ""
#~ "Отправление хранится в отделении один месяц. Если за это время его не "
#~ "забрать, оно вернётся к нам. Поэтому внимательно проверьте индекс "
#~ "отделения — после оформления его можно ещё раз посмотреть на странице "
#~ "заказа."

#~ msgid "Shartlar"
#~ msgstr "Условия"

#~ msgid ""
#~ "Joʻnatma boʻlimda bir oy saqlanadi. Indeks notoʻgʻri boʻlsa, darhol bizga "
#~ "yozing."
#~ msgstr ""
#~ "Отправление хранится в отделении один месяц. Если индекс указан неверно, "
#~ "сразу напишите нам."

#~ msgid "Shartlar va qoidalar"
#~ msgstr "Условия и правила"

#~ msgid "1. Umumiy shartlar"
#~ msgstr "1. Общие условия"

#~ msgid ""
#~ "Saytimizdan foydalanish va buyurtma berish orqali siz ushbu shartlarga "
#~ "rozilik bildirgan hisoblanasiz. Biz bu shartlarni istalgan vaqtda "
#~ "yangilash huquqiga egamiz. Kiritilgan oʻzgarishlar saytga joylangan "
#~ "zahoti kuchga kiradi."
#~ msgstr ""
#~ "Пользуясь сайтом и оформляя заказ, вы соглашаетесь с этими условиями. Мы "
#~ "вправе обновлять их в любое время; изменения вступают в силу с момента "
#~ "публикации на сайте."

#~ msgid "2. Buyurtma va toʻlov"
#~ msgstr "2. Заказ и оплата"

#~ msgid ""
#~ "Buyurtma rasmiylashtirish sahifasida koʻrsatilgan toʻlov usullari orqali "
#~ "toʻlanadi. Toʻlovni amalga oshirishdan avval yetkazib berish "
#~ "maʼlumotlaringizni diqqat bilan tekshiring: mijoz kiritgan notoʻgʻri "
#~ "manzil uchun javobgarlikni oʻz zimmamizga olmaymiz."
#~ msgstr ""
#~ "Заказ оплачивается теми способами, которые указаны на странице "
#~ "оформления. Перед оплатой внимательно проверьте данные доставки: за "
#~ "адрес, указанный покупателем неверно, мы ответственности не несём."

#~ msgid "3. Yetkazib berish"
#~ msgstr "3. Доставка"

#~ msgid ""
#~ "Barcha buyurtmalar Oʻzbekiston pochtasi orqali yuboriladi — Toshkentda "
#~ "ham, viloyatlarda ham. Bepul yetkazish chegarasi hozircha yoʻq."
#~ msgstr ""
#~ "Все заказы отправляются через «Узбекистон почтаси» — и в Ташкенте, и в "
#~ "областях. Порога бесплатной доставки пока нет."

#~ msgid ""
#~ "Buyurtmalarni imkon qadar tez joʻnatishga harakat qilamiz. Yetkazib "
#~ "berish muddati pochta xizmatining ish tartibiga bogʻliq."
#~ msgstr ""
#~ "Стараемся отправлять заказы как можно быстрее. Срок доставки зависит от "
#~ "работы почтовой службы."

#~ msgid "4. Qaytarish va almashtirish"
#~ msgstr "4. Возврат и обмен"

#~ msgid ""
#~ "Agar mahsulot shikastlangan holatda yetib borsa, olganingizdan keyin 24 "
#~ "soat ichida muammoni koʻrsatuvchi qisqa foto yoki video yuboring — "
#~ "mahsulotni almashtirib beramiz."
#~ msgstr ""
#~ "Если вещь приехала повреждённой, в течение 24 часов после получения "
#~ "пришлите короткое фото или видео с проблемой — заменим товар."

#~ msgid ""
#~ "Oʻlcham mos kelmasa, kiyilmagan, yuvilmagan va asl holatidagi mahsulotni "
#~ "mos oʻlchamga almashtirib beramiz."
#~ msgstr ""
#~ "Если размер не подошёл, обменяем вещь на нужный — при условии, что она не "
#~ "ношена, не стирана и в исходном виде."

#~ msgid ""
#~ "Maxsus buyurtmalar aynan sizning soʻrovingiz asosida tayyorlanadi, "
#~ "shuning uchun ishlab chiqarish boshlangandan keyin ular qaytarilmaydi."
#~ msgstr ""
#~ "Индивидуальные заказы делаются точно по вашему запросу, поэтому после "
#~ "запуска в производство они возврату не подлежат."

#~ msgid "5. Mahsulot koʻrinishining aniqligi"
#~ msgstr "5. Точность изображения товара"

#~ msgid ""
#~ "Futbolkalarimizning rangi va detallarini imkon qadar aniq koʻrsatishga "
#~ "harakat qilamiz. Ranglar ekran sozlamalariga qarab biroz farq qilishi "
#~ "mumkin."
#~ msgstr ""
#~ "Стараемся показывать цвет и детали футболок максимально точно. Оттенки "
#~ "могут немного отличаться в зависимости от настроек экрана."

#~ msgid ""
#~ "Siz taqdim etgan ism, telefon raqami va manzil faqat buyurtmangizni "
#~ "bajarish va yetkazib berish uchun ishlatiladi. Shaxsiy maʼlumotlaringiz "
#~ "marketing maqsadida uchinchi tomonlarga berilmaydi."
#~ msgstr ""
#~ "Имя, номер телефона и адрес, которые вы указываете, используются только "
#~ "для выполнения и доставки заказа. Персональные данные не передаются "
#~ "третьим лицам в маркетинговых целях."

#~ msgid "7. Aloqa"
#~ msgstr "7. Связаться с нами"

#~ msgid ""
#~ "Savollaringiz boʻlsa, Telegram orqali yoki aloqa sahifasidan bogʻlaning."
#~ msgstr ""
#~ "Если есть вопросы, напишите в Telegram или через страницу контактов."

