#: .\core\ratelimit.py:12
msgid "Juda koʻp urinish. Iltimos, birozdan soʻng qayta urinib koʻring."
msgstr "Too many attempts. Please try again shortly."

#: .\core\views.py:51
msgid "Iltimos, xabar kiriting."
msgstr "Please enter a message."

#: .\core\views.py:57
msgid "Xabar qabul qilindi."
msgstr "Message sent."

#: .\payment\views.py:34 .\payment\views.py:84
msgid "Savat boʻsh."
msgstr "Your cart is empty."

#: .\payment\views.py:57
msgid "Maʻlumot va manzilni toʻldiring."
msgstr "Please fill in your details and address."

