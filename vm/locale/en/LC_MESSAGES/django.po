msgid "Buyurtma allaqachon rasmiylashtirilgan."
msgstr "This order has already been placed."

#: .\payment\views.py:87
msgid "Buyurtma qabul qilindi. Toʻlovni amalga oshiring."
msgstr "Order received. Please complete payment."

