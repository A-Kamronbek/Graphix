# --- secrets ---
.env
.env.*
!.env.example

# --- python ---
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd

# --- virtualenvs ---
.venv/
venv/

# --- django ---
/media/
/staticfiles/
/logs/
*.sqlite3

# --- files the Claude desktop app drops here when delivering images ---
/Claude outputs/

# --- compiled translation catalogues ---
# .po files are the source and are tracked; .mo is build output and is
# regenerated by `manage.py compilemessages` on deploy.
*.mo

# --- editors / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- database dumps ---
# Real customer rows. Never in the repository, whatever the extension.
/backups/
*.dump
*.sql

# --- working notes and design scratch ---
# Kept on disk, out of the repository. The plan and the runbooks are working
# documents rather than part of the product, and the design folder is what
# Phase 2 was decided from - neither is useful to anyone cloning this.
/docs/PLAN.md
/docs/PROJECT_INSTRUCTIONS.md
/docs/brand/*
# ...but the source of the shipped OG image is not a working note:
# core.test_backlog asserts the card can still be redrawn.
!/docs/brand/og-card.html
/docs/design/
# deploy/RUNBOOK.md is TRACKED. It was ignored as a working note and went
# missing twice over. It holds no credential - only the names of the
# variables that do - and it is the procedure for updating production,
# which is the last thing that should live outside the repository.
/deploy/NEXT-STEPS.md

# --- screenshots ---
# Output, not source: regenerating them is one command, and a dozen megabytes
# of PNG in the history is a dozen megabytes forever.
/pictures/
/graphix-screenshots.zip

# pip leaves this inside the checkout on the server.
.cache/

# The service account's home directory IS the checkout on the server, so its
# dotfiles land in the worktree. These two are secrets - the database password
# and the deploy key - and untracked is not the same as ignored: one `git add
# -A` on that box would have committed both. Nothing of the kind is tracked.
.db_password
.ssh/
.netrc
.pgpass
