# GRAPHIX - delete customers' requests kept a year (plan §9 Phase 23).
#
# The privacy policy tells the customer a return or exchange request and its
# photographs are kept a year after it is closed, and a suggested design and
# its pictures a year after it was sent (§17 #406). Nothing else on the site
# deletes either, so if this timer is not installed the policy is a statement
# the server does not keep.

[Unit]
Description=GRAPHIX - prune requests kept a year
Wants=postgresql.service
After=postgresql.service

[Service]
Type=oneshot
User=graphix
Group=www-data
WorkingDirectory=/srv/graphix
ExecStart=/srv/graphix/.venv/bin/python manage.py prune_requests
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/graphix/logs /srv/graphix/media
