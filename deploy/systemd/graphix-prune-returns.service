# GRAPHIX - delete return requests closed more than a year ago (plan §9 Phase 23).
#
# The privacy policy tells the customer a return or exchange request and its
# photographs are kept a year after it is closed (§17 #406). Nothing else on
# the site deletes one, so if this timer is not installed the policy is a
# statement the server does not keep.

[Unit]
Description=GRAPHIX - prune closed return requests
Wants=postgresql.service
After=postgresql.service

[Service]
Type=oneshot
User=graphix
Group=www-data
WorkingDirectory=/srv/graphix
ExecStart=/srv/graphix/.venv/bin/python manage.py prune_return_requests
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/srv/graphix/logs /srv/graphix/media
