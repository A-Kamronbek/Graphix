# GRAPHIX environment variables.
# Copy this file to ".env" (same folder as manage.py) and fill in real values.
# Never commit the real .env — it holds secrets.

# --- core ---
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-fresh-random-key
# True only for local development; ALWAYS False in production.
DEBUG=True
# Comma-separated, no spaces. In production: graphix.uz,www.graphix.uz
ALLOWED_HOSTS=127.0.0.1,localhost
# Full origins (with scheme), comma-separated. Required in production so Django
# accepts form POSTs from the live HTTPS domain.
# In production: https://graphix.uz,https://www.graphix.uz
CSRF_TRUSTED_ORIGINS=

# --- database (PostgreSQL) ---
DB_NAME=mydb
DB_USER=myuser
DB_PASSWORD=mypassword
DB_HOST=localhost
DB_PORT=5432

# --- Click payment ---
CLICK_SERVICE_ID=your-click-service-id
CLICK_MERCHANT_ID=your-click-merchant-id
CLICK_SECRET_KEY=your-click-secret-key

# --- Payme and Octo (optional) ---
# Leave blank until you have them. A method whose credentials are blank shows
# as "Sozlanmagan" in Boshqaruv > Toʻlov usullari and refuses to build a pay
# link, so the customer is told plainly rather than sent to a gateway the shop
# cannot talk to. Switch the method off there until its keys are in: while it
# is on, the checkout still offers it.
PAYME_ID=
PAYME_KEY=
OCTO_SHOP_ID=
OCTO_SECRET=
# Octo signs its callbacks sha1(unique_key + payment_uuid + status), and Octo
# issues this key separately from the shop id and secret. With DEBUG on, Octo
# runs in test mode, signatures are not verified, and this may stay blank -
# which is enough to test the whole flow. In production it is REQUIRED:
# without it tolov refuses to construct the Octo callback at all, so a
# customer could pay and the order would never be marked paid. The site
# therefore treats Octo as unconfigured in production until this is set.
OCTO_UNIQUE_KEY=

# --- Eskiz SMS ---
ESKIZ_EMAIL=your-eskiz-account-email
ESKIZ_PASSWORD=your-eskiz-account-password
# 4546 is Eskiz's test sender; set your approved sender name in production.
ESKIZ_FROM=4546

# --- Google Maps (optional) ---
# The pin on the home-delivery half of checkout. Leave it BLANK and everything
# still works: the map block does not render and the customer types their
# address, which is what a blocked script or a denied permission produces anyway.
# When you do issue a key:
#   1. enable billing on the Google Cloud project — a card is required even
#      inside the free allowance;
#   2. restrict the key to HTTP referrers: https://graphix.uz/*, https://www.graphix.uz/*;
#   3. set a budget alert the same day.
GOOGLE_MAPS_API_KEY=

# --- Telegram (optional) ---
# Three notifications to the shop's staff: a PAID order, a contact message, and
# a review waiting for moderation. An order that is placed and never paid for is
# not announced at all (§17 #237) — the owner hears about money, not about
# abandoned carts. Leave everything blank and nothing is sent; a warning is
# logged and no request is broken. Two ways to switch them on - the first one
# set wins:
#
# 1. Through the shop's bot service. The site POSTs every event to the bot as
#    JSON signed with the shared secret, and the bot talks to Telegram.
#    WEBSITE_WEBHOOK_SECRET must be the same value the bot has. The URL must be
#    https:// unless the bot runs on this same server (http://127.0.0.1:...).
#    The contract for the bot: docs/integrations/telegram-bot.md
#    Generate a secret with:
#      python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_BOT_WEBHOOK_URL=
WEBSITE_WEBHOOK_SECRET=
#
# 2. Straight to Telegram. Create the bot with @BotFather, then get the chat id
#    by messaging the bot and reading
#    https://api.telegram.org/bot<TOKEN>/getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Used only to build absolute links inside those notifications.
SITE_URL=http://127.0.0.1:8000

# --- search engines ---
# Unset (the default): the site is indexable, which is what it should be
# once it sells something. Set to False and robots.txt says Disallow: / and
# every page carries a noindex.
#
# The production server has SITE_INDEXABLE=False until the catalogue is
# loaded (§19 Q37). Deleting that line is part of launching, not an
# afterthought: a site nobody can find sells nothing.
# SITE_INDEXABLE=False

# --- cache ---
# Unset (the default): Django caches in this process's own memory. Fine for
# local development and for a single worker; WRONG in production, because each
# gunicorn worker would then keep its own rate-limit counters and the real limit
# would be the configured one multiplied by the number of workers.
#
# Set it and Django uses Redis, which every worker shares. The `redis` package
# is in requirements.txt for exactly this — it is the one dependency §4's
# zero-new-dependencies rule makes an exception for (§17 #240) — so setting this
# variable is all that is needed on a machine where redis-server is running.
# REQUIRED in production. Install the server with:  apt install redis-server
# REDIS_URL=redis://127.0.0.1:6379/1
